# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for Order Shipping Map.
VITE_GOOGLE_MAPS_API_KEY=""

# MONGODB_URI: Optional MongoDB Atlas connection string.
# If omitted, the server persists data locally in ./data/kle-commerce-db.json.
MONGODB_URI=""

# JWT_SECRET: Signing secret for user and admin authentication tokens.
JWT_SECRET="kle-commerce-dev-secret-change-in-production"
